<?xml version="1.0"?>
<sdf version="1.9">
  <model name="aerointercept_park_surface">
    <static>true</static>
    <link name="surface">
      <collision name="ground_collision">
        <geometry><plane><normal>0 0 1</normal><size>160 160</size></plane></geometry>
        <surface><friction><ode><mu>0.85</mu><mu2>0.85</mu2></ode></friction></surface>
      </collision>
      <visual name="meadow">
        <cast_shadows>false</cast_shadows>
        <geometry><mesh><uri>meshes/ground.obj</uri></mesh></geometry>
        <material>
          <ambient>0.34 0.38 0.27 1</ambient><diffuse>1 1 1 1</diffuse><specular>0.02 0.02 0.02 1</specular>
          <pbr><metal>
            <albedo_map>materials/textures/meadow_albedo.png</albedo_map>
            <metalness>0.0</metalness><roughness>0.94</roughness>
          </metal></pbr>
        </material>
      </visual>
      <visual name="main_gravel_path">
        <pose>0 0 0.018 0 0 0</pose>
        <geometry><mesh><uri>meshes/path_long.obj</uri></mesh></geometry>
        <material>
          <ambient>0.42 0.36 0.28 1</ambient><diffuse>1 1 1 1</diffuse><specular>0.03 0.03 0.03 1</specular>
          <pbr><metal>
            <albedo_map>materials/textures/gravel_albedo.png</albedo_map>
            <metalness>0.0</metalness><roughness>0.89</roughness>
          </metal></pbr>
        </material>
      </visual>
      <visual name="north_gravel_path">
        <pose>8 7 0.020 0 0 0.42</pose>
        <geometry><mesh><uri>meshes/path_short.obj</uri></mesh></geometry>
        <material>
          <ambient>0.42 0.36 0.28 1</ambient><diffuse>1 1 1 1</diffuse><specular>0.03 0.03 0.03 1</specular>
          <pbr><metal>
            <albedo_map>materials/textures/gravel_albedo.png</albedo_map>
            <metalness>0.0</metalness><roughness>0.89</roughness>
          </metal></pbr>
        </material>
      </visual>
      <visual name="south_gravel_path">
        <pose>-10 -9 0.020 0 0 -0.52</pose>
        <geometry><mesh><uri>meshes/path_short.obj</uri></mesh></geometry>
        <material>
          <ambient>0.42 0.36 0.28 1</ambient><diffuse>1 1 1 1</diffuse><specular>0.03 0.03 0.03 1</specular>
          <pbr><metal>
            <albedo_map>materials/textures/gravel_albedo.png</albedo_map>
            <metalness>0.0</metalness><roughness>0.89</roughness>
          </metal></pbr>
        </material>
      </visual>
    </link>
  </model>
</sdf>
